{
  "name": "@agentsearchhq/agentsearch-mcp",
  "version": "1.2.0",
  "mcpName": "io.github.agentsearchhq-coder/agentsearch-mcp",
  "publishConfig": {
    "access": "public"
  },
  "description": "MCP server for a self-hosted AgentSearch API: web search, page extract, and JavaScript page rendering",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agentsearch-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example",
    "server.json",
    "smithery.yaml",
    "manifest.json",
    ".mcpbignore"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mcpb:validate": "mcpb validate manifest.json",
    "mcpb:pack": "npm run build && node scripts/pack-mcpb.mjs",
    "smithery:publish": "node scripts/publish-smithery.mjs",
    "test": "npm run build && node --test \"test/*.mjs\""
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agentsearch",
    "web-search",
    "render",
    "headless-browser",
    "javascript-rendering",
    "reviews",
    "service-status"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
