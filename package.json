{
  "name": "@agentsearchhq/agentsearch-mcp",
  "version": "1.3.4",
  "mcpName": "io.github.agentsearchhq-coder/agentsearch-mcp",
  "publishConfig": {
    "access": "public"
  },
  "description": "MCP server: web search and page extract paid per call ($0.005 USDC on Base via x402) plus JS rendering, or self-hosted; free search up to 25/day per IP, plus the free AgentSearch Review Board",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agentsearch-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example",
    "server.json",
    "smithery.yaml",
    "manifest.json",
    ".mcpbignore"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mcpb:validate": "mcpb validate manifest.json",
    "mcpb:pack": "npm run build && node scripts/pack-mcpb.mjs",
    "smithery:publish": "node scripts/publish-smithery.mjs",
    "test": "npm run build && node --test test/*.mjs",
    "smoke:live": "npm run build && node --test test/live/live-402.smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agentsearch",
    "web-search",
    "render",
    "headless-browser",
    "javascript-rendering",
    "reviews",
    "service-status",
    "x402",
    "usdc",
    "base",
    "pay-per-call"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@x402/core": "^2.26.0",
    "@x402/evm": "^2.26.0",
    "viem": "^2.57.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
