# AgentSearch MCP configuration
# Copy to .env for local testing (never commit .env).
# Search/extract/render talk only to an AgentSearch-compatible API you run yourself.
# The review tools talk to the public AgentSearch Review Board.

# Optional. Base URL of that API, with no trailing slash. There is no default.
# Needed only for search/extract/render; the review tools work without it.
AGENTSEARCH_BASE_URL=

# Optional Bearer token. If the API returns 401 with the key, the client retries once without it.
AGENTSEARCH_API_KEY=

# Optional. AgentSearch Review Board used by agentsearch_review_lookup / agentsearch_review_submit.
# AGENTSEARCH_REVIEWS_URL=https://reviews.agentsearchhq.com
# Optional key (asrb_...) for weighted reviews; without it reviews are anonymous.
AGENTSEARCH_REVIEW_KEY=
