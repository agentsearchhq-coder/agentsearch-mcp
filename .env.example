# AgentSearch MCP configuration
# Copy to .env for local testing (never commit .env).

# --- Pay per call (extract/render; search too only with AGENTSEARCH_MODE=paid) ---
# Private key (64 hex) of a NEW wallet made only for this, holding a little USDC on Base.
# Paid calls go to AgentSearch's own x402 API on Base by default: search $0.008, extract $0.007, render $0.010 (USDC).
# No ETH needed. The key is used only to sign payments. Alias: POCKET_PRIVATE_KEY.
AGENTSEARCH_WALLET_PRIVATE_KEY=
# Session spend cap in USDC atomic units (1000000 = $1.00, the default). Alias: POCKET_MAX_TOTAL_ATOMIC.
# AGENTSEARCH_MAX_TOTAL_ATOMIC=1000000
# Optional lower per-call cap (cannot exceed 10000 = $0.010; 5000 on the Pocket route). Alias: POCKET_MAX_PER_CALL_ATOMIC.
# AGENTSEARCH_MAX_PER_CALL_ATOMIC=10000
# Paid route: direct (default, AgentSearch's own x402 API) or pocket (Pocket Network Agentic Portal, $0.005 per call).
# AGENTSEARCH_PAYMENT_ROUTE=direct

# Search mode (search only): free (default, free relay even if a wallet key is set), paid (pay $0.008 per search, $0.005 on the Pocket route; needs the key above),
# auto (paid search when a wallet key is set, as in 1.3.0-1.3.4).
# AGENTSEARCH_MODE=free

# No-wallet free trial of extract (5/day per IP) and render (3/day per IP, no screenshots) via the free relay.
# Set to 0 to turn it off (no-wallet extract/render then make no network call).
# AGENTSEARCH_FREE_TRIAL=1

# --- Self-hosted (optional; takes precedence when set) ---
# Base URL of your own AgentSearch-compatible API, with no trailing slash.
AGENTSEARCH_BASE_URL=
# Optional Bearer token. If the API returns 401 with the key, the client retries once without it.
AGENTSEARCH_API_KEY=

# --- Review Board ---
# AGENTSEARCH_REVIEWS_URL=https://reviews.agentsearchhq.com
# Optional key (asrb_...) for weighted reviews; without it reviews are anonymous.
AGENTSEARCH_REVIEW_KEY=
