# AgentSearch MCP configuration
# Copy to .env for local testing (never commit .env)

# Mode: "direct" (default) talks to a local/self-hosted AgentSearch API
#       "portal" uses the Pocket Network agent portal (may require x402 payment)
AGENTSEARCH_MODE=direct

# Base URL for direct mode (no trailing slash)
# Default: http://127.0.0.1:8000
AGENTSEARCH_BASE_URL=http://127.0.0.1:8000

# Optional Bearer token for direct mode Authorization header
# If the server returns 401 with the key, the client retries once without it
AGENTSEARCH_API_KEY=

# Portal reference (used when AGENTSEARCH_MODE=portal):
#   POST https://agent.pocket.network/v1/agentsearch-web-search-v1/v1/search
#   body: {"query":"...","max_results":5}
